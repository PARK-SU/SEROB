+//! Process a puzzle whose solutions all share one non-given cell
+/**
+ * Same as <code>ratePuzzleC</code>, but several solutions are accepted,
+ * uniqueness techniques are skipped and the process stops at the first assignment.
+ * ER EP ED are 0 if no cell was assigned.
+ */
+int ratePuzzleOneCellC(char *ze, int * er, int * ep, int * ed, int * aig)
+{
+	PUZZLE* puz = new PUZZLE();
+	puz->options = Op;
+	puz->options.oonecell = 1;
+	int rc = puz->Traite(ze);
+	if(!puz->assigned || puz->stop_rating)
+		puz->ermax = puz->epmax = puz->edmax = 0;
+	*er = puz->ermax;
+	*ep = puz->epmax;
+	*ed = puz->edmax;
+	*aig = puz->stop_rating;
+	delete puz;
+	return  rc;
+}
